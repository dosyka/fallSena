# Default sdkconfig values for the FallSena firmware.
# Target chip: ESP32-C6.
CONFIG_IDF_TARGET="esp32c6"

# --- BLE (#FW5): NimBLE host stack ---
# Enable the Bluetooth controller and select the NimBLE host (low footprint,
# standard for the ESP32-C6). Peripheral role only: the device advertises and
# accepts connections from the caretaker app, it never scans/connects out.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
